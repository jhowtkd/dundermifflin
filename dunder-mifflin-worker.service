[Unit]
Description=Dunder Mifflin Worker v2.0 (SQLite Edition)
After=network.target

[Service]
Type=simple
User=clawd
WorkingDirectory=/home/clawd/.openclaw/workspace/projects/dunder-mifflin
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/clawd/.openclaw/workspace/projects/dunder-mifflin/.env.worker
ExecStart=/home/clawd/.openclaw/workspace/projects/dunder-mifflin/venv/bin/python /home/clawd/.openclaw/workspace/projects/dunder-mifflin/worker_v2.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
