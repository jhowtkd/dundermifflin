<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>Dunder Mifflin - Propostas</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=VT323&amp;family=Press+Start+2P&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <style type="text/tailwindcss">
        :root {
            --win-bg: #c0c0c0;
            --win-highlight: #ffffff;
            --win-shadow: #808080;
            --win-shadow-dark: #404040;
            --terminal-green: #00FF41;
        }
        @layer utilities {
            .win95-raised {
                box-shadow: inset 1.5px 1.5px 0px var(--win-highlight),
                            inset -1.5px -1.5px 0px var(--win-shadow),
                            1.5px 1.5px 0px var(--win-shadow-dark);
            }
            .win95-inset {
                box-shadow: inset 1.5px 1.5px 0px var(--win-shadow),
                            inset -1.5px -1.5px 0px var(--win-highlight);
                background-color: #dfdfdf;
            }
            .win95-button {
                @apply bg-[var(--win-bg)] border-none relative active:translate-y-[1px] active:translate-x-[1px];
                box-shadow: inset 1.5px 1.5px 0px var(--win-highlight),
                            inset -1.5px -1.5px 0px var(--win-shadow),
                            1px 1px 0px 1px #000;
            }
            .win95-card {
                @apply bg-[var(--win-bg)] p-1;
                box-shadow: inset 1.5px 1.5px 0px var(--win-highlight),
                            inset -1.5px -1.5px 0px var(--win-shadow),
                            3px 3px 0px 0px rgba(0,0,0,0.4);
            }
            .win95-window-title {
                background: linear-gradient(90deg, #000080, #1084d0);
            }
            .win95-input {
                @apply bg-white border-2 border-gray-400 px-2 py-1 font-mono text-sm;
                box-shadow: inset 1px 1px 2px rgba(0,0,0,0.2);
            }
            .win95-select {
                @apply bg-white border-2 border-gray-400 px-2 py-1 font-mono text-sm;
                box-shadow: inset 1px 1px 2px rgba(0,0,0,0.2);
            }
        }
        .crt-overlay {
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            background-size: 100% 3px, 3px 100%;
            pointer-events: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 50;
        }
    </style>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#00FF41",
                        "background-light": "#7ea2a2",
                        "background-dark": "#0D1117",
                    },
                    fontFamily: {
                        display: ['"Press Start 2P"', 'cursive'],
                        mono: ['"VT323"', 'monospace'],
                    },
                },
            },
        };
    </script>
</head>
<body class="bg-background-light dark:bg-background-dark font-mono text-lg min-h-screen text-gray-900 dark:text-gray-300 relative overflow-x-hidden selection:bg-primary selection:text-black">
    <div class="crt-overlay"></div>

    <!-- Header -->
    <header class="win95-raised bg-[var(--win-bg)] dark:bg-black p-1 sticky top-0 z-40 mb-4 mx-1">
        <div class="max-w-7xl mx-auto flex justify-between items-center px-4 py-1">
            <div class="flex items-center space-x-3">
                <a href="/index.html" class="text-2xl select-none hover:opacity-80">🏢</a>
                <h1 class="font-display text-[10px] md:text-sm text-black dark:text-primary uppercase tracking-tighter">
                    Dunder Mifflin <span class="hidden sm:inline">- Propostas</span>
                </h1>
            </div>
            <div id="api-status" class="flex items-center space-x-2 bg-black/10 px-2 py-1 win95-inset">
                <div class="w-3 h-3 bg-gray-500 border border-black/20"></div>
                <span class="text-[10px] font-display text-gray-600">CONNECTING...</span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-4 space-y-6 relative z-10">
        <!-- Navigation -->
        <div class="flex flex-wrap gap-3 py-2 px-1 border-b-2 border-black/20">
            <a href="/index.html" class="win95-button px-4 py-2 flex items-center space-x-2">
                <span class="material-symbols-outlined text-sm">home</span>
                <span class="font-display text-[9px]">Dashboard</span>
            </a>
            <a href="/proposals.html" class="win95-button px-4 py-2 flex items-center space-x-2 bg-blue-100">
                <span class="material-symbols-outlined text-sm text-blue-700">edit_note</span>
                <span class="font-display text-[9px] text-blue-900">Propostas</span>
            </a>
            <a href="/missions.html" class="win95-button px-4 py-2 flex items-center space-x-2">
                <span class="material-symbols-outlined text-sm">rocket_launch</span>
                <span class="font-display text-[9px]">Missões</span>
            </a>
            <a href="/agents.html" class="win95-button px-4 py-2 flex items-center space-x-2">
                <span class="material-symbols-outlined text-sm">smart_toy</span>
                <span class="font-display text-[9px]">Agentes</span>
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- New Proposal Form -->
            <section class="win95-card">
                <div class="win95-window-title flex justify-between items-center px-2 py-1">
                    <div class="flex items-center space-x-2">
                        <span class="text-lg">📝</span>
                        <h2 class="font-display text-[10px] text-white tracking-widest">NOVA PROPOSTA</h2>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-900 win95-inset m-1 p-4">
                    <form id="proposal-form" class="space-y-4">
                        <!-- Agent Select -->
                        <div>
                            <label class="block text-[10px] font-display text-gray-700 mb-1">AGENTE</label>
                            <select id="agent-select" class="win95-select w-full" required>
                                <option value="">Selecione um agente...</option>
                            </select>
                        </div>

                        <!-- Title -->
                        <div>
                            <label class="block text-[10px] font-display text-gray-700 mb-1">TÍTULO</label>
                            <input type="text" id="proposal-title" class="win95-input w-full" placeholder="Título da missão" required />
                        </div>

                        <!-- Description -->
                        <div>
                            <label class="block text-[10px] font-display text-gray-700 mb-1">DESCRIÇÃO</label>
                            <textarea id="proposal-description" class="win95-input w-full h-24" placeholder="Descreva a missão..."></textarea>
                        </div>

                        <!-- Mission Type -->
                        <div>
                            <label class="block text-[10px] font-display text-gray-700 mb-1">TIPO</label>
                            <select id="mission-type" class="win95-select w-full">
                                <option value="general">General</option>
                                <option value="content">Content</option>
                                <option value="carousel">Carousel</option>
                                <option value="research">Research</option>
                                <option value="social">Social</option>
                                <option value="review">Code Review</option>
                                <option value="test">Testing</option>
                            </select>
                        </div>

                        <!-- Priority -->
                        <div>
                            <label class="block text-[10px] font-display text-gray-700 mb-1">PRIORIDADE</label>
                            <select id="priority" class="win95-select w-full">
                                <option value="3">Baixa (3)</option>
                                <option value="5" selected>Normal (5)</option>
                                <option value="7">Alta (7)</option>
                                <option value="10">Crítica (10)</option>
                            </select>
                        </div>

                        <!-- Submit -->
                        <div class="pt-2">
                            <button type="submit" class="win95-button px-6 py-2 w-full flex items-center justify-center space-x-2">
                                <span class="material-symbols-outlined text-sm">send</span>
                                <span class="font-display text-[10px]">CRIAR PROPOSTA</span>
                            </button>
                        </div>
                    </form>

                    <div id="form-message" class="mt-4 hidden"></div>
                </div>
            </section>

            <!-- Pending Proposals List -->
            <section class="win95-card">
                <div class="win95-window-title flex justify-between items-center px-2 py-1">
                    <div class="flex items-center space-x-2">
                        <span class="text-lg">⏳</span>
                        <h2 class="font-display text-[10px] text-white tracking-widest">PROPOSTAS PENDENTES</h2>
                    </div>
                </div>

                <div class="bg-white dark:bg-gray-900 win95-inset m-1 p-4 min-h-[400px] max-h-[500px] overflow-y-auto">
                    <div id="proposals-list">
                        <!-- Proposals will be rendered here -->
                        <div class="text-center py-8 font-mono text-gray-500">
                            Carregando propostas...
                        </div>
                    </div>
                </div>

                <div class="bg-[var(--win-bg)] text-[10px] font-display text-gray-700 p-1">
                    <div class="win95-inset px-2 py-0.5" id="proposals-count">0 pendentes</div>
                </div>
            </section>
        </div>
    </main>

    <!-- Scripts -->
    <script src="/js/api.js"></script>
    <script src="/js/app.js"></script>
    <script>
        let agents = [];
        let proposals = [];

        async function loadAgentsForSelect() {
            try {
                const data = await API.agents();
                agents = data.agents || [];

                const select = document.getElementById('agent-select');
                select.innerHTML = '<option value="">Selecione um agente...</option>';

                agents.forEach(agent => {
                    const option = document.createElement('option');
                    option.value = agent.id;
                    option.textContent = `${agent.avatar_emoji || '🤖'} ${agent.name} (${agent.department})`;
                    select.appendChild(option);
                });
            } catch (e) {
                console.error('Error loading agents:', e);
            }
        }

        async function loadProposals() {
            try {
                const data = await API.proposals('pending');
                proposals = data.proposals || [];
                renderProposals();
            } catch (e) {
                console.error('Error loading proposals:', e);
            }
        }

        function renderProposals() {
            const container = document.getElementById('proposals-list');
            const countEl = document.getElementById('proposals-count');

            if (proposals.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 font-mono text-gray-500">
                        Nenhuma proposta pendente
                    </div>
                `;
                countEl.textContent = '0 pendentes';
                return;
            }

            container.innerHTML = proposals.map(p => `
                <div class="win95-raised bg-[var(--win-bg)] p-3 mb-3">
                    <div class="flex justify-between items-start mb-2">
                        <div class="flex-1">
                            <h4 class="font-display text-[10px] text-black">${p.title}</h4>
                            <div class="text-[11px] font-mono text-gray-600 mt-1">
                                ${p.avatar_emoji || '🤖'} ${p.agent_name || 'N/A'} • ${p.mission_type || 'general'}
                            </div>
                        </div>
                        <span class="px-2 py-1 text-[8px] font-display text-white bg-yellow-500">
                            PENDENTE
                        </span>
                    </div>
                    ${p.description ? `<p class="text-sm text-gray-600 mb-2">${p.description}</p>` : ''}
                    <div class="flex gap-2 mt-3">
                        <button onclick="approveProposal(${p.id})" class="win95-button px-3 py-1 flex items-center space-x-1 bg-green-100">
                            <span class="material-symbols-outlined text-sm text-green-700">check</span>
                            <span class="font-display text-[8px] text-green-800">APROVAR</span>
                        </button>
                        <button onclick="rejectProposal(${p.id})" class="win95-button px-3 py-1 flex items-center space-x-1 bg-red-100">
                            <span class="material-symbols-outlined text-sm text-red-700">close</span>
                            <span class="font-display text-[8px] text-red-800">REJEITAR</span>
                        </button>
                    </div>
                </div>
            `).join('');

            countEl.textContent = `${proposals.length} pendentes`;
        }

        async function approveProposal(id) {
            try {
                const result = await API.approveProposal(id);
                showMessage('Proposta aprovada! Missão criada.', 'success');
                loadProposals();
            } catch (e) {
                showMessage('Erro ao aprovar proposta.', 'error');
            }
        }

        async function rejectProposal(id) {
            // For now, just remove from list (you could add a reject endpoint)
            showMessage('Proposta rejeitada.', 'warning');
            loadProposals();
        }

        function showMessage(text, type = 'info') {
            const el = document.getElementById('form-message');
            const colors = {
                success: 'bg-green-100 text-green-800 border-green-500',
                error: 'bg-red-100 text-red-800 border-red-500',
                warning: 'bg-yellow-100 text-yellow-800 border-yellow-500',
                info: 'bg-blue-100 text-blue-800 border-blue-500'
            };

            el.className = `p-3 border-2 ${colors[type]} font-mono text-sm`;
            el.textContent = text;
            el.classList.remove('hidden');

            setTimeout(() => {
                el.classList.add('hidden');
            }, 3000);
        }

        // Form submission
        document.getElementById('proposal-form').addEventListener('submit', async (e) => {
            e.preventDefault();

            const data = {
                agentId: parseInt(document.getElementById('agent-select').value),
                title: document.getElementById('proposal-title').value,
                description: document.getElementById('proposal-description').value,
                missionType: document.getElementById('mission-type').value,
                priority: parseInt(document.getElementById('priority').value)
            };

            if (!data.agentId || !data.title) {
                showMessage('Preencha todos os campos obrigatórios.', 'error');
                return;
            }

            try {
                const result = await API.createProposal(data);
                showMessage(`Proposta criada: ${result.code}`, 'success');
                document.getElementById('proposal-form').reset();
                loadProposals();
            } catch (e) {
                showMessage('Erro ao criar proposta.', 'error');
            }
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', async () => {
            await loadAgentsForSelect();
            await loadProposals();

            // Check API status
            try {
                const health = await API.health();
                if (health.status === 'ok') {
                    document.getElementById('api-status').innerHTML = `
                        <div class="w-3 h-3 bg-primary animate-pulse border border-black/20"></div>
                        <span class="text-[10px] font-display text-green-700 dark:text-primary">API ONLINE</span>
                    `;
                }
            } catch (e) {}

            // Auto-refresh proposals
            setInterval(loadProposals, 10000);
        });

        // Dark mode
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
    </script>
</body>
</html>
