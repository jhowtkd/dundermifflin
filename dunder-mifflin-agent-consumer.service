[Unit]
Description=Dunder Mifflin Agent Queue Consumer
After=network.target dunder-mifflin-api.service

[Service]
Type=simple
User=clawd
WorkingDirectory=/home/clawd/.openclaw/workspace/projects/dunder-mifflin
Environment=PYTHONPATH=/home/clawd/.openclaw/workspace/projects/dunder-mifflin
Environment=PATH=/home/clawd/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /home/clawd/.openclaw/workspace/projects/dunder-mifflin/agent_queue_consumer_loop.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
